@mjml({
  fonts: {
    Niramit: 'https://fonts.googleapis.com/css?family=Niramit:400,500,700'
  }
})
<mjml >
  <mj-body background-color="#F2F2F2">
    <mj-section background-color="#FFFFFF">
      <mj-column>

        <mj-text font-size="20px" color="#2B2B2B" font-family="Niramit">Inspection Request Update</mj-text>
        <mj-text font-size="16px" color="#464646" font-family="Murecho">Hi {{userName}},</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho">We have reviewed your inspection request and unfortunately, it cannot be approved at this time.</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho"><strong>Property:</strong> {{propertyTitle}}</mj-text>
        <mj-text font-size="16px" color="#464646" font-family="Murecho"><strong>Inspection ID:</strong> {{inspectionId}}</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho"><strong>Reason:</strong></mj-text>
        <mj-text font-size="16px" color="#464646" font-family="Murecho">{{reason}}</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho">You can contact our support team if you need further clarification or wish to submit a new request.</mj-text>

      </mj-column>

    </mj-section>
    <mj-section>
    <mj-column >
      <mj-text align="center"><span  style="color: #464646">Sent by </span> <span style="color: #080808">Property Sec</span> </mj-text>
        <mj-text align="center">Privacy Policy | Terms and Conditions</mj-text>

       <mj-text align="center"><span style="color: #464646">If you have any questions please contact us at</span>  <span>{{supportEmail}}</span> </mj-text>


      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
@end