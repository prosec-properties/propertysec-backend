@mjml({
  fonts: {
    Niramit: 'https://fonts.googleapis.com/css?family=Niramit:400,500,700'
  }
})
<mjml >
  <mj-body background-color="#F2F2F2">
    <mj-section background-color="#FFFFFF">
      <mj-column>

        <mj-text font-size="20px" color="#2B2B2B" font-family="Niramit">Property Published Successfully!</mj-text>
        <mj-text font-size="16px" color="#464646" font-family="Murecho">Hi {{userName}},</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho">Congratulations! Your property "{{propertyTitle}}" has been reviewed and published successfully. It is now visible to potential buyers on our platform.</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho">Property ID: {{propertyId}}</mj-text>

        <mj-text font-size="16px" color="#464646" font-family="Murecho">You can view your published property in your dashboard or share it with others.</mj-text>

      </mj-column>

    </mj-section>
    <mj-section>
    <mj-column >
      <mj-text align="center"><span  style="color: #464646">Sent by </span> <span style="color: #080808">Property Sec</span> </mj-text>
        <mj-text align="center">Privacy Policy | Terms and Conditions</mj-text>

       <mj-text align="center"><span style="color: #464646">If you have any questions please contact us at</span>  <span>{{supportEmail}}</span> </mj-text>


      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
@end